---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, u } from '../data/site';
import ogDefault from '../assets/img/poseidon.jpg';
import { getImage } from 'astro:assets';
import goticaUrl from '@fontsource/grenze-gotisch/files/grenze-gotisch-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, image = ogDefault, noindex = false, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site ?? site.url).href;
const fullTitle = title.includes(site.nombre) ? title : `${title} · ${site.nombre}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: site.nombreLargo,
  url: site.url,
  email: site.email,
  image: ogUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.direccion.calle,
    postalCode: site.direccion.cp,
    addressLocality: site.direccion.ciudad,
    addressRegion: site.direccion.provincia,
    addressCountry: site.direccion.pais,
  },
  sameAs: [site.instagram.url],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b0a09" />
    <link rel="preload" href={goticaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href={u('/marca/favicon-32.png')} />
    <link rel="apple-touch-icon" href={u('/marca/favicon-180.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.nombreLargo} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class:list={['grano', bodyClass]}>
    <a href="#contenido" class="sr-only-focusable fixed left-4 top-4 z-[100] bg-hueso px-4 py-2 text-tinta">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      import { initScroll, initReveals } from '../scripts/motion';
      initScroll();
      initReveals();
    </script>
  </body>
</html>
