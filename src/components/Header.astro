---
import { nav, site, mailtoCita, u } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="cabecera fixed inset-x-0 top-0 z-50" data-cabecera>
  <div class="contenedor flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href={u('/')} class="flex items-center gap-3" aria-label={`${site.nombre}, inicio`}>
      <img src={u('/marca/logo-blanco.svg')} alt="" width="26" height="41" class="h-10 w-auto" />
      <span class="versalita hidden text-hueso sm:inline">B Ink Tattoo</span>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-10">
        {nav.map((item) => (
          <li>
            <a href={item.href} class:list={['versalita trazo text-hueso-2 transition-colors hover:text-hueso', path === item.href && 'activo text-hueso']} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <a href={site.instagram.url} target="_blank" rel="noopener" class="versalita trazo hidden text-hueso-2 hover:text-hueso lg:inline">Instagram</a>
      <a href={mailtoCita()} class="boton hidden !py-3 md:inline-flex">Pide cita</a>
      <button class="menu-btn versalita md:hidden" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-btn>
        <span class="menu-btn__txt">Menú</span>
        <span class="menu-btn__aro" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="menu-movil" data-menu hidden>
    <div class="menu-movil__aro" aria-hidden="true"></div>
    <nav aria-label="Menú móvil" class="contenedor flex h-full flex-col justify-center gap-2">
      <a href={u('/')} class="menu-movil__link gotica">Inicio</a>
      {nav.map((item) => <a href={item.href} class="menu-movil__link gotica">{item.label}</a>)}
      <div class="menu-movil__pie mt-12 flex flex-col gap-3 text-hueso-2">
        <a href={`mailto:${site.email}`} class="text-sm">{site.email}</a>
        <a href={site.instagram.url} target="_blank" rel="noopener" class="text-sm">{site.instagram.usuario}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .cabecera { transition: transform .7s var(--ease-tinta), background-color .5s; }
  .cabecera::before {
    content: ""; position: absolute; inset: 0 0 -2.5rem; pointer-events: none; z-index: -1;
    background: linear-gradient(to bottom, rgb(11 10 9 / .78), transparent);
    opacity: 0; transition: opacity .5s;
  }
  :global(.scrolled) .cabecera::before { opacity: 1; }
  :global(.oculta) .cabecera { transform: translateY(-110%); }
  :global(.menu-abierto) .cabecera { transform: none; }
  .activo { background-size: 100% 1px; }

  .menu-btn { position: relative; display: inline-flex; align-items: center; gap: .75rem; color: var(--color-hueso); z-index: 2; }
  .menu-btn__aro { width: 1.6rem; height: 1.6rem; border: 1px solid var(--color-laton); border-radius: 50%; transition: transform .6s var(--ease-tinta), background .4s; }
  @media (min-width: 768px) { .menu-btn, .menu-movil { display: none !important; } }
  .menu-btn[aria-expanded="true"] .menu-btn__aro { transform: scale(.55); background: var(--color-laton); }

  .menu-movil { position: fixed; inset: 0; z-index: 1; background: var(--color-tinta); clip-path: circle(0% at calc(100% - 2.2rem) 2.25rem); transition: clip-path .9s var(--ease-tinta); }
  .menu-movil.abierto { clip-path: circle(150% at calc(100% - 2.2rem) 2.25rem); }
  .menu-movil__aro { position: absolute; width: 130vw; aspect-ratio: 1; right: -65vw; top: 15%; border-radius: 50%; border: 1px solid rgb(194 160 106 / .35); box-shadow: 0 0 60px rgb(194 160 106 / .12), inset 0 0 60px rgb(194 160 106 / .08); }
  .menu-movil__link { font-size: clamp(3.5rem, 17vw, 6rem); color: var(--color-hueso); transform: translateY(40%); opacity: 0; transition: transform .8s var(--ease-tinta), opacity .8s var(--ease-tinta); }
  .menu-movil.abierto .menu-movil__link { transform: none; opacity: 1; }
  .menu-movil.abierto .menu-movil__link:nth-child(2) { transition-delay: .06s; }
  .menu-movil.abierto .menu-movil__link:nth-child(3) { transition-delay: .12s; }
  .menu-movil.abierto .menu-movil__link:nth-child(4) { transition-delay: .18s; }
</style>

<script>
  import { getLenis } from '../scripts/motion';
  const root = document.documentElement;
  let last = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    root.classList.toggle('scrolled', y > 40);
    root.classList.toggle('oculta', y > last && y > window.innerHeight * 0.8);
    last = y;
  }, { passive: true });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const txt = btn?.querySelector('.menu-btn__txt');
  function set(open: boolean) {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    if (txt) txt.textContent = open ? 'Cerrar' : 'Menú';
    root.classList.toggle('menu-abierto', open);
    if (open) { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('abierto')); getLenis()?.stop(); }
    else { menu.classList.remove('abierto'); getLenis()?.start(); setTimeout(() => { if (!menu.classList.contains('abierto')) menu.hidden = true; }, 900); }
  }
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
