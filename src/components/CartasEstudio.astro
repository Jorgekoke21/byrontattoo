---
/**
 * «El estudio»: abanico de cartas en 3D.
 * Escritorio → abanico con perspectiva: pasar para levantar, clic para fijar, repetir para ampliar.
 * Táctil     → baraja: deslizar para pasar carta, tocar para ampliar.
 */
import { getImage } from 'astro:assets';
import { cartas } from '../data/estudio';
import fondo from '../assets/img/sesion-aro.jpg';

interface Props { titulo?: string; eyebrow?: string }
const { titulo = 'El estudio', eyebrow = 'B Ink Tattoo · Monforte de Lemos' } = Astro.props;

const items = await Promise.all(
  cartas.map(async (c, i) => ({
    ...c,
    i,
    thumb: await getImage({ src: c.img, width: 620, format: 'webp', quality: 80 }),
    full: await getImage({ src: c.img, width: 1500, format: 'webp', quality: 84 }),
  })),
);
const bg = await getImage({ src: fondo, width: 1200, format: 'webp', quality: 70 });
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="cartas" data-cartas aria-labelledby="cartas-titulo">
  <div class="cartas__fondo" aria-hidden="true" style={`background-image:url(${bg.src})`}></div>

  <header class="cartas__cabecera contenedor">
    <p class="etiqueta" data-sube>{eyebrow}</p>
    <h2 id="cartas-titulo" class="cartas__titulo gotica" data-sube><span class="linea"><span>{titulo}</span></span></h2>
    <p class="cartas__ayuda versalita" data-sube>
      <span class="solo-raton">Pasa para levantar · clic para fijar · repite para ampliar</span>
      <span class="solo-tactil">Desliza para pasar · toca para ampliar</span>
    </p>
  </header>

  <div class="cartas__mesa" data-mesa>
    <ul class="cartas__abanico" data-abanico role="list">
      {items.map((c) => (
        <li class="carta" data-carta data-i={c.i}>
          <button type="button" class="carta__btn" aria-label={`${c.titulo}. ${c.nota}`} data-full={c.full.src} data-titulo={c.titulo} data-nota={c.nota} data-alt={c.alt}>
            <img src={c.thumb.src} alt="" width={c.thumb.attributes.width} height={c.thumb.attributes.height} class:list={['carta__img', c.mono && 'mono']} loading="lazy" decoding="async" draggable="false" />
            <span class="carta__sombra" aria-hidden="true"></span>
            <span class="carta__num versalita" aria-hidden="true">{pad(c.i + 1)}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="cartas__leyenda contenedor" aria-live="polite">
    <p class="cartas__contador gotica" data-contador>01</p>
    <div>
      <p class="cartas__nombre" data-leyenda-nombre>{items[0].titulo}</p>
      <p class="cartas__nota" data-leyenda-nota>{items[0].nota}</p>
    </div>
    <div class="cartas__flechas solo-tactil">
      <button type="button" class="cartas__flecha" data-prev aria-label="Carta anterior">←</button>
      <button type="button" class="cartas__flecha" data-next aria-label="Carta siguiente">→</button>
    </div>
  </div>

  <dialog class="visor" data-visor aria-label="Fotografía ampliada">
    <figure class="visor__fig">
      <img data-visor-img alt="" />
      <figcaption><span class="etiqueta" data-visor-num></span><span class="visor__tit gotica" data-visor-tit></span><span class="visor__nota" data-visor-nota></span></figcaption>
    </figure>
    <button type="button" class="visor__cerrar versalita" data-visor-cerrar>Cerrar</button>
    <button type="button" class="visor__nav visor__nav--prev" data-visor-prev aria-label="Anterior">←</button>
    <button type="button" class="visor__nav visor__nav--next" data-visor-next aria-label="Siguiente">→</button>
  </dialog>
</section>

<style>
  .cartas { position: relative; padding-top: clamp(5rem, 12vh, 8rem); padding-bottom: clamp(3rem, 8vh, 6rem); overflow: hidden; isolation: isolate; }
  .cartas__fondo { position: absolute; inset: 0 0 35%; z-index: -1; background-size: cover; background-position: center 35%; filter: grayscale(1) brightness(.32) contrast(1.1);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / .9), transparent); -webkit-mask-image: linear-gradient(to bottom, rgb(0 0 0 / .9), transparent); }
  .cartas__cabecera { transition: opacity .6s var(--ease-tinta); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; position: relative; z-index: 2; }
  .cartas.con-fijada .cartas__cabecera { opacity: .18; }
  .cartas__titulo { font-size: clamp(4.2rem, 11vw, 11rem); }
  .cartas__ayuda { color: var(--color-hueso-2); }
  .solo-tactil { display: none; }
  @media (hover: none), (pointer: coarse) { .solo-tactil { display: inline; } .solo-raton { display: none; } .cartas__flechas.solo-tactil { display: flex; } }

  .cartas__mesa { --cw: clamp(180px, 16.5vw, 300px); position: relative; height: calc(var(--cw) * 2.3); margin-top: clamp(-3rem, -4vh, -1rem); perspective: 1700px; perspective-origin: 50% 20%; }
  .cartas__abanico { position: absolute; inset: 0; transform-style: preserve-3d; list-style: none; margin: 0; padding: 0; pointer-events: none; }
  .carta { pointer-events: auto; position: absolute; left: 50%; bottom: 17%; width: var(--cw); aspect-ratio: 3 / 4; margin-left: calc(var(--cw) / -2); transform-origin: 50% 165%; will-change: transform; }
  .carta__btn { position: relative; display: block; width: 100%; height: 100%; padding: 0; border-radius: 14px; overflow: hidden; cursor: pointer;
    background: var(--color-tinta-3); border: 1px solid rgb(236 230 218 / .22);
    box-shadow: 0 22px 50px rgb(0 0 0 / .55), 0 2px 0 rgb(255 255 255 / .06) inset;
    transition: border-color .5s var(--ease-tinta), box-shadow .5s var(--ease-tinta); }
  .carta__img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; user-select: none; }
  .carta__sombra { position: absolute; inset: 0; background: linear-gradient(to top, rgb(11 10 9 / .55), transparent 45%); transition: background-color .5s; }
  .carta__num { position: absolute; left: .9rem; bottom: .8rem; color: var(--color-hueso); }
  .carta.atenuada .carta__sombra { background-color: rgb(11 10 9 / .55); }
  .carta.fijada .carta__btn { border-color: var(--color-laton-claro); box-shadow: 0 0 0 1px var(--color-laton), 0 0 40px rgb(232 204 146 / .35), 0 40px 90px rgb(0 0 0 / .7); }
  .carta__btn:focus-visible { outline-offset: 3px; }

  .cartas__leyenda { position: relative; display: flex; align-items: center; justify-content: center; gap: 1.5rem; min-height: 4.5rem; text-align: left; }
  .cartas__contador { font-size: 3.4rem; color: var(--color-laton); min-width: 3.2ch; text-align: right; }
  .cartas__nombre { font-size: 1.05rem; font-weight: 500; }
  .cartas__nota { color: var(--color-hueso-2); font-size: .9rem; max-width: 26rem; }
  .cartas__flechas { gap: .5rem; margin-left: auto; }
  .cartas__flecha { width: 3rem; height: 3rem; border: 1px solid rgb(236 230 218 / .3); border-radius: 50%; color: var(--color-hueso); }

  /* Baraja táctil */
  .cartas.baraja .cartas__mesa { --cw: min(68vw, 330px); height: calc(var(--cw) * 1.62); perspective: 1200px; margin-top: 2rem; }
  .cartas.baraja .carta { bottom: auto; top: 0; transform-origin: 50% 80%; touch-action: pan-y; }
  .cartas.baraja .carta, .cartas.baraja .carta * { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  /* En móvil la foto de fondo ya viene oscura: sin filtros ni máscaras que repintar */
  :global(.lite) .cartas__fondo { filter: none; opacity: .3; -webkit-mask-image: none; mask-image: none; }
  :global(.lite) .carta__btn { box-shadow: 0 10px 24px rgb(0 0 0 / .5); }
  .cartas.baraja .cartas__leyenda { justify-content: flex-start; }
  .cartas.baraja .cartas__contador { font-size: 2.6rem; min-width: auto; }

  /* Visor */
  .visor { width: 100vw; height: 100svh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(11 10 9 / .96); color: var(--color-hueso); }
  .visor::backdrop { background: transparent; }
  .visor[open] { display: grid; place-items: center; }
  .visor__fig { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; max-width: 92vw; }
  .visor__fig img { max-height: 78svh; max-width: 92vw; width: auto; object-fit: contain; border-radius: 6px; }
  .visor__fig figcaption { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  .visor__tit { font-size: 2.2rem; }
  .visor__nota { color: var(--color-hueso-2); font-size: .9rem; }
  .visor__cerrar { position: absolute; top: 1.5rem; right: var(--gutter); }
  .visor__nav { position: absolute; top: 50%; translate: 0 -50%; width: 3.2rem; height: 3.2rem; border-radius: 50%; border: 1px solid rgb(236 230 218 / .3); }
  .visor__nav--prev { left: var(--gutter); } .visor__nav--next { right: var(--gutter); }
  @media (max-width: 767px) { .visor__nav { top: auto; bottom: 1.5rem; translate: none; } }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion, getLenis } from '../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-cartas]').forEach((root) => {
    const mesa = root.querySelector<HTMLElement>('[data-mesa]')!;
    const abanico = root.querySelector<HTMLElement>('[data-abanico]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-carta]')];
    const btns = cards.map((c) => c.querySelector<HTMLButtonElement>('button')!);
    const N = cards.length;
    const elCont = root.querySelector<HTMLElement>('[data-contador]')!;
    const elNom = root.querySelector<HTMLElement>('[data-leyenda-nombre]')!;
    const elNota = root.querySelector<HTMLElement>('[data-leyenda-nota]')!;
    const visor = root.querySelector<HTMLDialogElement>('[data-visor]')!;
    const rm = reduceMotion();
    const pad = (n: number) => String(n).padStart(2, '0');

    const leyenda = (i: number) => {
      const b = btns[i];
      elCont.textContent = pad(i + 1);
      elNom.textContent = b.dataset.titulo ?? '';
      elNota.textContent = b.dataset.nota ?? '';
    };

    // ── Visor ──────────────────────────────────────────────
    let vi = 0;
    const vImg = visor.querySelector<HTMLImageElement>('[data-visor-img]')!;
    function abrirVisor(i: number) {
      vi = (i + N) % N;
      const b = btns[vi];
      vImg.src = b.dataset.full!; vImg.alt = b.dataset.alt ?? '';
      visor.querySelector('[data-visor-num]')!.textContent = `${pad(vi + 1)} / ${pad(N)}`;
      visor.querySelector('[data-visor-tit]')!.textContent = b.dataset.titulo ?? '';
      visor.querySelector('[data-visor-nota]')!.textContent = b.dataset.nota ?? '';
      if (!visor.open) {
        visor.showModal(); getLenis()?.stop();
        if (!rm) gsap.fromTo(visor.querySelector('.visor__fig'), { scale: 0.92, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.7, ease: 'expo.out' });
      }
    }
    visor.addEventListener('close', () => { getLenis()?.start(); btns[vi]?.focus({ preventScroll: true }); });
    visor.querySelector('[data-visor-cerrar]')!.addEventListener('click', () => visor.close());
    visor.querySelector('[data-visor-prev]')!.addEventListener('click', () => abrirVisor(vi - 1));
    visor.querySelector('[data-visor-next]')!.addEventListener('click', () => abrirVisor(vi + 1));
    visor.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
    visor.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') abrirVisor(vi + 1); if (e.key === 'ArrowLeft') abrirVisor(vi - 1); });

    let modo: 'abanico' | 'baraja' | null = null;
    let limpiar: (() => void) | null = null;

    // ══ ABANICO (ratón) ═══════════════════════════════════════
    function abanicoInit() {
      root.classList.remove('baraja');
      let hover = -1, fijada = -1, entrado = rm;
      const cw = () => cards[0].offsetWidth;

      function pose(i: number) {
        const o = i - (N - 1) / 2, w = cw();
        const p = { x: o * w * 0.44, y: Math.abs(o) ** 1.5 * 4, rotation: o * 7.5, rotationY: o * -3, z: -Math.abs(o) * 16, scale: 1, zIndex: 10 + i };
        if (fijada >= 0) {
          if (i === fijada) return { x: 0, y: -w * 0.14, rotation: 0, rotationY: 0, z: 220, scale: 1.3, zIndex: 100 };
          const r = i - fijada;
          return { ...p, x: o * w * 0.5 + Math.sign(r) * w * 0.3, rotation: o * 9, z: p.z - 60, zIndex: 10 + i };
        }
        if (hover >= 0) {
          if (i === hover) return { ...p, y: p.y - w * 0.26, rotation: p.rotation * 0.4, z: 90, scale: 1.07, zIndex: 60 };
          const r = i - hover;
          return { ...p, x: p.x + Math.sign(r) * w * (0.2 / Math.abs(r) ** 0.6), rotation: p.rotation + Math.sign(r) * 2 };
        }
        return p;
      }
      function layout(dur = 0.75, ease = 'expo.out') {
        cards.forEach((c, i) => {
          const p = pose(i);
          gsap.to(c, { ...p, duration: rm ? 0 : dur, ease, overwrite: 'auto' });
          c.classList.toggle('fijada', i === fijada);
          c.classList.toggle('atenuada', fijada >= 0 && i !== fijada);
        });
        root.classList.toggle('con-fijada', fijada >= 0);
      }

      // Estado inicial: mazo cerrado en el centro
      if (!rm) {
        cards.forEach((c, i) => gsap.set(c, { x: 0, y: 160, rotation: (i - N / 2) * 1.2, rotationY: 0, z: -200, opacity: 0, scale: 0.9, zIndex: 10 + i }));
        ScrollTrigger.create({
          trigger: mesa, start: 'top 78%', once: true,
          onEnter: () => {
            gsap.to(cards, { opacity: 1, y: 40, z: 0, duration: 0.6, ease: 'power2.out', stagger: 0.04 });
            gsap.delayedCall(0.5, () => { entrado = true; cards.forEach((c, i) => gsap.to(c, { ...pose(i), duration: 1.3, ease: 'expo.out', delay: Math.abs(i - (N - 1) / 2) * 0.06 })); });
          },
        });
      } else layout(0);

      // Inclinación de la mesa con el ratón
      const rx = gsap.quickTo(abanico, 'rotationX', { duration: 1, ease: 'power3' });
      const ry = gsap.quickTo(abanico, 'rotationY', { duration: 1, ease: 'power3' });
      gsap.set(abanico, { rotationX: 8 });
      const onMove = (e: PointerEvent) => {
        const r = mesa.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5, ny = (e.clientY - r.top) / r.height - 0.5;
        rx(8 - ny * 6); ry(nx * 8);
      };
      mesa.addEventListener('pointermove', onMove);
      const onLeaveMesa = () => { rx(8); ry(0); if (fijada < 0 && hover >= 0) { hover = -1; if (entrado) layout(); } };
      mesa.addEventListener('pointerleave', onLeaveMesa);

      const handlers: Array<[HTMLElement, string, EventListener]> = [];
      const on = (el: HTMLElement, ev: string, fn: EventListener) => { el.addEventListener(ev, fn); handlers.push([el, ev, fn]); };
      cards.forEach((c, i) => {
        const b = btns[i];
        on(b, 'pointerenter', () => { if (!entrado || fijada >= 0) return; hover = i; leyenda(i); layout(0.6); });
        on(b, 'focus', () => { if (!entrado || fijada >= 0) return; hover = i; leyenda(i); layout(0.6); });
        on(b, 'click', () => {
          if (fijada === i) { abrirVisor(i); return; }
          fijada = i; hover = -1; leyenda(i); layout(0.9);
        });
        on(b, 'keydown', ((e: KeyboardEvent) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); btns[(i + 1) % N].focus(); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); btns[(i - 1 + N) % N].focus(); }
        }) as EventListener);
      });
      const onDoc = (e: Event) => {
        if (fijada < 0 || visor.open) return;
        if ((e as KeyboardEvent).key && (e as KeyboardEvent).key !== 'Escape') return;
        if (e.type === 'pointerdown' && (e.target as HTMLElement).closest('[data-carta]')) return;
        fijada = -1; layout(0.9);
      };
      document.addEventListener('pointerdown', onDoc);
      document.addEventListener('keydown', onDoc);
      const onResize = () => entrado && layout(0);
      window.addEventListener('resize', onResize);

      return () => {
        handlers.forEach(([el, ev, fn]) => el.removeEventListener(ev, fn));
        mesa.removeEventListener('pointermove', onMove);
        mesa.removeEventListener('pointerleave', onLeaveMesa);
        document.removeEventListener('pointerdown', onDoc);
        document.removeEventListener('keydown', onDoc);
        window.removeEventListener('resize', onResize);
        gsap.set(abanico, { clearProps: 'transform' });
        cards.forEach((c) => { gsap.killTweensOf(c); gsap.set(c, { clearProps: 'all' }); c.classList.remove('fijada', 'atenuada'); });
      };
    }

    // ══ BARAJA (táctil) ═══════════════════════════════════════
    function barajaInit() {
      root.classList.add('baraja');
      let orden = cards.map((_, i) => i);
      const ROT = [0, -6, 7, -9.5, 11, -12, 13, -14];
      const pose = (k: number) => ({ x: k === 0 ? 0 : (k % 2 ? -1 : 1) * (6 + k * 4), y: k * 12, rotation: ROT[k] ?? 0, scale: 1 - k * 0.045, z: -k * 40, opacity: k < 5 ? 1 : 0, zIndex: 100 - k });
      const layout = (dur = 0.6) => orden.forEach((ci, k) => gsap.to(cards[ci], { ...pose(k), duration: rm ? 0 : dur, ease: 'expo.out', overwrite: 'auto' }));
      if (!rm) {
        cards.forEach((c) => gsap.set(c, { y: 120, opacity: 0, rotation: 0, scale: 0.9 }));
        ScrollTrigger.create({ trigger: mesa, start: 'top 80%', once: true, onEnter: () => orden.forEach((ci, k) => gsap.to(cards[ci], { ...pose(k), duration: 1.1, ease: 'expo.out', delay: (N - k) * 0.05 })) });
      } else layout(0);
      leyenda(orden[0]);

      const siguiente = (dir = 1) => {
        const top = cards[orden[0]];
        const w = mesa.offsetWidth;
        gsap.to(top, {
          x: dir * w * 0.95, rotation: dir * 22, y: -20, duration: rm ? 0 : 0.45, ease: 'power2.in', overwrite: 'auto',
          onComplete: () => {
            orden = [...orden.slice(1), orden[0]];
            gsap.set(top, { zIndex: 1 });
            layout(0.7); leyenda(orden[0]);
          },
        });
      };
      const anterior = () => {
        const ci = orden[orden.length - 1];
        orden = [ci, ...orden.slice(0, -1)];
        const w = mesa.offsetWidth;
        gsap.set(cards[ci], { x: -w * 0.95, rotation: -22, zIndex: 200, opacity: 1 });
        layout(0.7); leyenda(orden[0]);
      };

      // Arrastre de la carta superior
      let sx = 0, sy = 0, dx = 0, t0 = 0, arrastrando = false, eje: 'x' | 'y' | null = null, pid = -1;
      const down = (e: PointerEvent) => {
        const c = (e.target as HTMLElement).closest<HTMLElement>('[data-carta]');
        if (!c || +c.dataset.i! !== orden[0]) return;
        sx = e.clientX; sy = e.clientY; dx = 0; t0 = performance.now(); arrastrando = true; eje = null; pid = e.pointerId;
        // El dedo queda "enganchado" a la carta aunque salga de ella
        try { c.setPointerCapture(e.pointerId); } catch {}
        gsap.killTweensOf(c);
      };
      const move = (e: PointerEvent) => {
        if (!arrastrando || e.pointerId !== pid) return;
        const mx = e.clientX - sx, my = e.clientY - sy;
        if (!eje && Math.hypot(mx, my) > 8) eje = Math.abs(mx) > Math.abs(my) ? 'x' : 'y';
        if (eje !== 'x') return;
        dx = mx;
        gsap.set(cards[orden[0]], { x: dx, rotation: dx * 0.06, y: -Math.abs(dx) * 0.05 });
        // la carta de debajo se adelanta un poco
        const k = Math.min(1, Math.abs(dx) / 160);
        const n = cards[orden[1]]; const a = pose(1), b = pose(0);
        gsap.set(n, { y: a.y + (b.y - a.y) * k, scale: a.scale + (b.scale - a.scale) * k, rotation: a.rotation * (1 - k) });
      };
      const up = (e: PointerEvent) => {
        if (!arrastrando || e.pointerId !== pid) return;
        arrastrando = false;
        const dt = performance.now() - t0;
        const v = Math.abs(dx) / Math.max(1, dt);
        if (eje === 'x' && (Math.abs(dx) > 60 || v > 0.45)) siguiente(Math.sign(dx) || 1);
        else if (eje) layout(0.5);
        // Solo un toque corto y limpio abre el visor; un gesto cancelado o una pulsación larga, no
        else if (e.type === 'pointerup' && dt < 450) abrirVisor(orden[0]);
        else layout(0.5);
      };
      const noMenu = (e: Event) => e.preventDefault(); // sin menú nativo «Compartir / Guardar imagen»
      mesa.addEventListener('contextmenu', noMenu);
      mesa.addEventListener('pointerdown', down);
      window.addEventListener('pointermove', move, { passive: true });
      window.addEventListener('pointerup', up);
      window.addEventListener('pointercancel', up);
      // En baraja los botones no abren por clic (lo gestiona el gesto), pero sí con teclado
      const onKey = (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrirVisor(orden[0]); } };
      const prevent = (e: Event) => e.preventDefault();
      btns.forEach((b) => { b.addEventListener('click', prevent); b.addEventListener('keydown', onKey); });
      const bPrev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
      const bNext = root.querySelector<HTMLButtonElement>('[data-next]')!;
      const fPrev = () => anterior(), fNext = () => siguiente(1);
      bPrev.addEventListener('click', fPrev); bNext.addEventListener('click', fNext);

      return () => {
        mesa.removeEventListener('contextmenu', noMenu);
        mesa.removeEventListener('pointerdown', down);
        window.removeEventListener('pointermove', move);
        window.removeEventListener('pointerup', up);
        window.removeEventListener('pointercancel', up);
        btns.forEach((b) => { b.removeEventListener('click', prevent); b.removeEventListener('keydown', onKey); });
        bPrev.removeEventListener('click', fPrev); bNext.removeEventListener('click', fNext);
        cards.forEach((c) => { gsap.killTweensOf(c); gsap.set(c, { clearProps: 'all' }); });
      };
    }

    const mq = matchMedia('(hover: none), (pointer: coarse), (max-width: 767px)');
    const elegir = () => {
      const m = mq.matches ? 'baraja' : 'abanico';
      if (m === modo) return;
      limpiar?.(); modo = m;
      limpiar = m === 'baraja' ? barajaInit() : abanicoInit();
    };
    mq.addEventListener('change', elegir);
    elegir();
  });
</script>
