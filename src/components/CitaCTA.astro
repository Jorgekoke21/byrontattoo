---
/**
 * Llamada a la cita. Mientras no haya otros canales confirmados: correo e Instagram.
 * El vídeo es una pieza real en color (el único color fuerte de la página: la tinta).
 */
import { site, mailtoCita, u } from '../data/site';
interface Props { titulo?: [string, string] }
const { titulo = ['Pide tu', 'cita'] } = Astro.props;
const [t1, t2] = titulo;
---
<section class="cita" data-cita aria-labelledby="cita-titulo">
  <div class="cita__escena contenedor">
    <div class="cita__ventana" data-cita-ventana>
      <video muted loop playsinline preload="none" poster={u('/media/pieza-color.webp')} data-cita-video aria-hidden="true" tabindex="-1">
        <source src={u('/media/pieza-color.av1.mp4')} type="video/mp4; codecs=av01.0.05M.08" />
        <source src={u('/media/pieza-color.mp4')} type="video/mp4" />
      </video>
      <span class="cita__aro" aria-hidden="true"></span>
    </div>
    <h2 id="cita-titulo" class="cita__titulo gotica" data-sube>
      <span class="linea cita__t1"><span>{t1}</span></span>
      <span class="linea cita__t2"><span>{t2}</span></span>
    </h2>
  </div>

  <div class="cita__info contenedor">
    <p class="cita__lead" data-sube>Cuéntanos tu idea, la zona del cuerpo y el tamaño aproximado. Si tienes referencias, adjúntalas.</p>
    <div class="cita__acciones" data-sube>
      <a href={mailtoCita()} class="boton boton--laton">Escribir un correo</a>
      <a href={site.instagram.url} target="_blank" rel="noopener" class="boton">Instagram</a>
    </div>
    <dl class="cita__datos" data-sube>
      <div><dt class="versalita">Correo</dt><dd><a class="trazo" href={mailtoCita()}>{site.email}</a></dd></div>
      <div><dt class="versalita">Instagram</dt><dd><a class="trazo" href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.usuario}</a></dd></div>
      <div><dt class="versalita">Estudio</dt><dd>{site.direccion.calle}<br />{site.direccion.cp} {site.direccion.ciudad} · <a class="trazo" href={site.mapa} target="_blank" rel="noopener">Cómo llegar</a></dd></div>
    </dl>
  </div>
</section>

<style>
  .cita { position: relative; padding-block: clamp(6rem, 14vh, 10rem) clamp(4rem, 10vh, 7rem); overflow: hidden; }
  .cita__escena { position: relative; display: grid; place-items: center; min-height: min(90svh, 56rem); }
  .cita__ventana { position: relative; width: clamp(15rem, 27vw, 27rem); aspect-ratio: 9 / 16; border-radius: 999px 999px 0 0; overflow: hidden; background: var(--color-tinta-3); }
  .cita__ventana video { width: 100%; height: 100%; object-fit: cover; }
  .cita__aro { position: absolute; inset: 0; border-radius: inherit; border: 1px solid rgb(232 204 146 / .55); box-shadow: inset 0 0 60px rgb(0 0 0 / .6); pointer-events: none; }
  :global(.lite) .cita__titulo { text-shadow: none; }
  .cita__titulo { position: absolute; inset: 0; pointer-events: none; font-size: clamp(5rem, 15vw, 17rem); color: var(--color-hueso); text-shadow: 0 .05em .4em rgb(0 0 0 / .5); }
  .cita__titulo .linea { position: absolute; }
  .cita__t1 { left: var(--gutter); top: 18%; }
  .cita__t2 { right: var(--gutter); bottom: 14%; }

  .cita__info { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem 1.5rem; margin-top: clamp(3rem, 8vh, 5rem); }
  .cita__lead { grid-column: 1 / 7; font-size: clamp(1.25rem, 2vw, 1.8rem); line-height: 1.3; text-wrap: balance; }
  .cita__acciones { grid-column: 8 / 13; display: flex; gap: .75rem; flex-wrap: wrap; align-self: center; justify-content: flex-end; }
  .cita__datos { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; border-top: 1px solid rgb(236 230 218 / .14); padding-top: 1.5rem; }
  .cita__datos dt { color: var(--color-humo); margin-bottom: .5rem; }
  .cita__datos dd { color: var(--color-hueso-2); line-height: 1.55; }

  @media (max-width: 767px) {
    .cita__escena { min-height: 78svh; }
    .cita__ventana { width: 64vw; }
    .cita__titulo { font-size: clamp(4.2rem, 22vw, 7rem); }
    .cita__t1 { top: 6%; } .cita__t2 { bottom: 4%; }
    .cita__lead, .cita__acciones, .cita__datos { grid-column: 1 / -1; }
    .cita__acciones { justify-content: stretch; } .cita__acciones .boton { flex: 1; justify-content: center; }
    .cita__datos { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { gsap, reduceMotion, lite } from '../scripts/motion';
  document.querySelectorAll<HTMLElement>('[data-cita]').forEach((root) => {
    const v = root.querySelector<HTMLVideoElement>('[data-cita-video]')!;
    const rm = reduceMotion();
    new IntersectionObserver(([e]) => { if (e.isIntersecting && !rm) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause(); }, { threshold: 0.2 }).observe(v);
    if (rm || lite()) return;
    const ventana = root.querySelector<HTMLElement>('[data-cita-ventana]')!;
    gsap.fromTo(ventana, { clipPath: 'inset(30% 20% 0% 20% round 999px 999px 0 0)' }, { clipPath: 'inset(0% 0% 0% 0% round 999px 999px 0 0)', ease: 'power2.out',
      scrollTrigger: { trigger: ventana, start: 'top 90%', end: 'center 60%', scrub: 0.6 } });
    gsap.fromTo(root.querySelector('.cita__t1'), { xPercent: -12 }, { xPercent: 6, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.fromTo(root.querySelector('.cita__t2'), { xPercent: 12 }, { xPercent: -6, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } });
  });
</script>
