---
/**
 * HERO «El aro».
 * El aro de luz del estudio (la lámpara circular real del puesto de Byron) convertido en portal.
 * El vídeo vertical de baja resolución se muestra dentro del círculo a un tamaño cercano al nativo
 * (≈ 576 px), así nunca se amplía lo bastante como para delatar la pérdida de calidad.
 */
import { mailtoCita, u } from '../data/site';
---
<section class="hero" data-hero aria-labelledby="hero-titulo">
  <div class="hero__escena" data-escena>
    <div class="hero__atmos" aria-hidden="true" style={`background-image:url(${u('/media/hero-aro.jpg')})`}></div>
    <p class="hero__fondo gotica contorno" aria-hidden="true" data-fondo>B Ink</p>

    <div class="hero__centro" data-centro>
      <div class="hero__portal" data-portal>
        <video data-video muted playsinline loop preload="auto" poster={u('/media/hero-aro.jpg')} aria-hidden="true" tabindex="-1">
          <source src={u('/media/hero-aro.mp4')} type="video/mp4" />
        </video>
        <div class="hero__vineta"></div>
        <div class="hero__velo" data-velo></div>
        <div class="hero__destello" data-destello></div>
      </div>

      <svg class="hero__aro" viewBox="0 0 1000 1000" aria-hidden="true" data-aro>
        <defs>
          <linearGradient id="latón" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f3dcaa" />
            <stop offset=".35" stop-color="#c2a06a" />
            <stop offset=".6" stop-color="#7d6440" />
            <stop offset="1" stop-color="#e8cc92" />
          </linearGradient>
          <filter id="halo" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="16" /></filter>
          <filter id="halo-fino" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="3.5" /></filter>
        </defs>
        <g transform="rotate(-90 500 500)">
          <circle class="aro__glow" cx="500" cy="500" r="468" fill="none" stroke="url(#latón)" stroke-width="22" filter="url(#halo)" pathLength="1" />
          <circle class="aro__glow" cx="500" cy="500" r="468" fill="none" stroke="url(#latón)" stroke-width="6" filter="url(#halo-fino)" pathLength="1" />
          <circle class="aro__linea" cx="500" cy="500" r="468" fill="none" stroke="url(#latón)" stroke-width="2.2" pathLength="1" />
          <circle class="aro__chispa" cx="500" cy="500" r="468" fill="none" stroke="#fff6e2" stroke-width="5" pathLength="1" filter="url(#halo-fino)" />
        </g>
      </svg>
    </div>

    <h1 id="hero-titulo" class="hero__titulo gotica">
      <span class="linea hero__l1"><span data-chars>Dibujado</span></span>
      <span class="linea hero__l2"><span data-chars>desde cero</span></span>
    </h1>

    <div class="hero__pie contenedor" data-pie>
      <p class="hero__sub">
        <span class="etiqueta">B Ink Tattoo Studio</span>
        <span class="hero__sub-txt">Hecho para quedarse. Estudio de tatuaje en el centro de Monforte de Lemos.</span>
      </p>
      <div class="hero__acciones">
        <a href={u('/trabajos')} class="boton">Ver trabajos</a>
        <a href={mailtoCita()} class="boton boton--laton">Pide tu cita</a>
      </div>
    </div>

    <div class="hero__lateral versalita" aria-hidden="true" data-lateral>
      <span>Monforte de Lemos</span><span class="hero__lateral-linea"></span><span>Desliza</span>
    </div>

    <canvas class="hero__humo" data-humo aria-hidden="true"></canvas>
  </div>
</section>

<style>
  .hero { position: relative; }
  .hero__escena { position: relative; height: 100svh; overflow: hidden; isolation: isolate; background: radial-gradient(120% 90% at 50% 45%, #171411 0%, var(--color-tinta) 62%); }

  /* Atmósfera: el póster del vídeo, muy desenfocado. Aporta luz sin delatar la resolución. */
  .hero__atmos { position: absolute; inset: -10%; background-size: cover; background-position: center 30%; filter: blur(60px) brightness(.35) saturate(0); opacity: .55; transform: scale(1.1); z-index: -2; }

  .hero__fondo { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -54%); font-size: clamp(14rem, 44vw, 46rem); white-space: nowrap; z-index: -1; -webkit-text-stroke-color: rgb(236 230 218 / .07); user-select: none; }

  .hero__centro { --d: min(66svh, 40vw, 600px); position: absolute; left: 50%; top: 47%; width: var(--d); height: var(--d); translate: -50% -50%; }
  .hero__portal { position: absolute; inset: 3.2%; border-radius: 50%; overflow: hidden; background: #000; clip-path: circle(50% at 50% 50%); isolation: isolate; transform: translateZ(0); }
  .hero__portal video { width: 100%; height: 100%; object-fit: cover; object-position: 50% 32%; transform-origin: 50% 40%; }
  .hero__velo, .hero__destello { position: absolute; inset: 0; background: #0b0a09; opacity: 0; pointer-events: none; }
  .hero__destello { background: radial-gradient(circle, #fff6e2 0%, #e8cc92 60%, #c2a06a 100%); mix-blend-mode: screen; }
  .hero__vineta { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 50% 45%, transparent 48%, rgb(11 10 9 / .55) 78%, rgb(11 10 9 / .9) 100%); }
  .hero__aro { position: absolute; inset: -6%; width: 112%; height: 112%; overflow: visible; pointer-events: none; }
  .aro__glow { opacity: .9; mix-blend-mode: screen; }
  .aro__chispa { stroke-dasharray: .035 .965; opacity: .9; mix-blend-mode: screen; }

  .hero__titulo { position: absolute; inset: 0; pointer-events: none; z-index: 3; font-size: clamp(4.2rem, 11.2vw, 12.5rem); color: var(--color-hueso); text-shadow: 0 .04em .35em rgb(0 0 0 / .45); }
  .hero__titulo .linea { position: absolute; padding-inline: .06em; }
  .hero__l1 { left: var(--gutter); top: 22%; }
  .hero__l2 { right: var(--gutter); top: 50%; }
  .hero__titulo :global(.ch) { will-change: transform; }

  .hero__pie { position: absolute; inset: auto 0 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding-bottom: clamp(1.5rem, 4.5vh, 3rem); z-index: 4; }
  .hero__sub { display: flex; flex-direction: column; gap: .7rem; max-width: 22rem; }
  .hero__sub-txt { color: var(--color-hueso-2); font-size: .95rem; line-height: 1.5; }
  .hero__acciones { display: flex; gap: .75rem; flex-wrap: wrap; }

  .hero__lateral { position: absolute; right: calc(var(--gutter) * .55); top: 50%; translate: 50% -50%; rotate: 90deg; display: flex; align-items: center; gap: 1rem; color: var(--color-humo); white-space: nowrap; z-index: 4; }
  .hero__lateral-linea { width: 4rem; height: 1px; background: currentColor; transform-origin: left; animation: deslizar 2.4s var(--ease-suave) infinite; }
  @keyframes deslizar { 0% { transform: scaleX(0); } 50% { transform: scaleX(1); transform-origin: left; } 50.01% { transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }

  .hero__humo { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 80%, transparent); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 80%, transparent); }

  /* ── Móvil: el aro se hace más grande que el ancho de pantalla útil, el vídeo se ve casi nativo ── */
  @media (max-width: 767px) {
    .hero__centro { --d: min(86vw, 52svh); top: 46%; }
    .hero__titulo { font-size: clamp(3.6rem, 19vw, 6rem); }
    .hero__l1 { left: calc(var(--gutter) * .8); top: 13%; }
    .hero__l2 { right: calc(var(--gutter) * .8); top: auto; bottom: 26%; }
    .hero__pie { flex-direction: column; align-items: stretch; gap: 1.25rem; }
    .hero__sub-txt { display: none; }
    .hero__acciones .boton { flex: 1; justify-content: center; }
    .hero__lateral { display: none; }
  }

  /* Estado inicial antes de la animación de entrada (solo si hay JS y movimiento) */
  :global(.js-motion) .hero__portal { clip-path: circle(0% at 50% 50%); }
  :global(.js-motion) .aro__linea, :global(.js-motion) .aro__glow { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.js-motion) .aro__chispa, :global(.js-motion) .hero__pie, :global(.js-motion) .hero__lateral { opacity: 0; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion, splitChars } from '../scripts/motion';
  import { Humo } from '../scripts/humo';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const video = hero.querySelector<HTMLVideoElement>('[data-video]')!;
    const portal = hero.querySelector<HTMLElement>('[data-portal]')!;
    const aro = hero.querySelector<SVGElement>('[data-aro]')!;
    const lineas = hero.querySelectorAll<SVGCircleElement>('.aro__linea, .aro__glow');
    const chispa = hero.querySelector<SVGCircleElement>('.aro__chispa')!;
    const glows = hero.querySelectorAll<SVGCircleElement>('.aro__glow');
    const l1 = hero.querySelector<HTMLElement>('.hero__l1')!;
    const l2 = hero.querySelector<HTMLElement>('.hero__l2')!;
    const pie = hero.querySelector<HTMLElement>('[data-pie]')!;
    const lateral = hero.querySelector<HTMLElement>('[data-lateral]')!;
    const fondo = hero.querySelector<HTMLElement>('[data-fondo]')!;
    const centro = hero.querySelector<HTMLElement>('[data-centro]')!;
    const escena = hero.querySelector<HTMLElement>('[data-escena]')!;
    const canvas = hero.querySelector<HTMLCanvasElement>('[data-humo]')!;
    const velo = hero.querySelector<HTMLElement>('[data-velo]')!;
    const destello = hero.querySelector<HTMLElement>('[data-destello]')!;

    const rm = reduceMotion();
    // Con movimiento reducido el vídeo no se reproduce solo: se queda el póster.
    const play = () => { if (!rm) video.play().catch(() => {}); };

    if (!rm) {
      document.documentElement.classList.add('js-motion');
      const chars = [...hero.querySelectorAll<HTMLElement>('[data-chars]')].map(splitChars);

      // ── Entrada: el aro se enciende como una lámpara ──
      const tl = gsap.timeline({ delay: 0.25, defaults: { ease: 'expo.out' } });
      tl.to(lineas, { strokeDashoffset: 0, duration: 1.6, ease: 'power3.inOut', stagger: 0.05 })
        // parpadeo de encendido, como un fluorescente
        .fromTo(glows, { opacity: 0 }, { keyframes: { opacity: [0, 0.7, 0.05, 0.85, 0.25, 1, 0.9] }, duration: 0.9, ease: 'none' }, '-=0.5')
        .add(play, '<')
        .to(portal, { clipPath: 'circle(50% at 50% 50%)', duration: 1.6 }, '<0.1')
        .fromTo(video, { scale: 1.3 }, { scale: 1, duration: 2.2 }, '<')
        .fromTo(destello, { opacity: 0.9 }, { opacity: 0, duration: 1.5, ease: 'power2.out' }, '<')
        .from(chars[0], { yPercent: 120, rotate: 6, duration: 1.3, stagger: 0.035 }, '<0.3')
        .from(chars[1], { yPercent: 120, rotate: -6, duration: 1.3, stagger: 0.035 }, '<0.12')
        .to([pie, lateral], { opacity: 1, duration: 1 }, '<0.5')
        .from(pie, { y: 24, duration: 1.2 }, '<')
        .to(chispa, { opacity: 0.9, duration: 0.6 }, '<');

      // Chispa de luz que recorre el aro de forma continua
      gsap.fromTo(chispa, { strokeDashoffset: 0 }, { strokeDashoffset: -1, duration: 7, ease: 'none', repeat: -1 });
      // Respiración suave del halo
      gsap.to(glows, { opacity: 0.6, duration: 2.6, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 3 });

      // Parallax leve con el ratón (solo escritorio)
      if (matchMedia('(hover: hover)').matches) {
        const qx = gsap.quickTo(centro, 'x', { duration: 1.2, ease: 'power3' });
        const qy = gsap.quickTo(centro, 'y', { duration: 1.2, ease: 'power3' });
        const fx = gsap.quickTo(fondo, 'x', { duration: 1.8, ease: 'power3' });
        hero.addEventListener('pointermove', (e) => {
          const nx = e.clientX / innerWidth - 0.5, ny = e.clientY / innerHeight - 0.5;
          qx(nx * 18); qy(ny * 14); fx(nx * -40);
        });
      }

      // ── Salida con scroll: el aro nos atraviesa y el estudio se disuelve en tinta ──
      const humo = new Humo(canvas, { modo: 'portal', origen: [0.5, 0.47], escala: 0.45 });
      const st = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: hero, start: 'top top', end: '+=120%', scrub: 0.6, pin: escena, pinSpacing: true,
          onUpdate: (s) => {
            const p = gsap.utils.clamp(0, 1, (s.progress - 0.12) / 0.88);
            // el humo brota del portal, alcanza su máximo y se disipa antes de soltar la sección
            humo.set(p, p < 0.6 ? 1 : Math.max(0, 1 - (p - 0.6) / 0.4));
          },
          onLeave: () => video.pause(), onEnterBack: play,
        },
      });
      st.fromTo(l1, { xPercent: 0, opacity: 1 }, { xPercent: -38, opacity: 0, duration: 0.4 }, 0)
        .fromTo(l2, { xPercent: 0, opacity: 1 }, { xPercent: 38, opacity: 0, duration: 0.4 }, 0)
        .fromTo([pie, lateral], { opacity: 1, y: 0 }, { opacity: 0, y: -20, duration: 0.2 }, 0)
        .fromTo(aro, { scale: 1, opacity: 1 }, { scale: 3.4, opacity: 0, duration: 0.45, ease: 'power2.in' }, 0.02)
        .fromTo(fondo, { scale: 1, opacity: 1 }, { scale: 1.3, opacity: 0, duration: 0.5 }, 0)
        // la luz del estudio se apaga: el portal se encoge y se funde a negro
        .fromTo(portal, { scale: 1, opacity: 1 }, { scale: 0.38, duration: 0.6, ease: 'power2.inOut' }, 0.12)
        .fromTo(velo, { opacity: 0 }, { opacity: 1, duration: 0.45 }, 0.3)
        .to(portal, { opacity: 0, duration: 0.15 }, 0.7)
        .to(escena, { backgroundColor: '#0b0a09', duration: 0.4 }, 0.3)
        .to({}, { duration: 0.15 });
    }

    // Ahorro: pausar el vídeo si la pestaña no está visible
    document.addEventListener('visibilitychange', () => (document.hidden ? video.pause() : play()));
    ScrollTrigger.refresh();
  }
</script>
