---
/**
 * «Cómo trabajamos»: lista editorial con letras (referencia web1), sin tarjetas.
 * Contenido basado en los valores de la web antigua, reescrito sin añadir promesas nuevas.
 */
import { Image } from 'astro:assets';
import material from '../assets/img/material.jpg';

const pasos = [
  { l: 'A', t: 'Escuchamos tu idea', d: 'Nos cuentas qué quieres llevar y por qué. A partir de ahí empieza el diseño.' },
  { l: 'B', t: 'Diseño desde cero', d: 'Cada pieza se dibuja para ti, adaptada a tu historia y a lo que imaginas.' },
  { l: 'C', t: 'Higiene sin atajos', d: 'Estándares estrictos de higiene y seguridad en cada sesión.' },
  { l: 'D', t: 'En el centro de Monforte', d: 'Un estudio cercano y cómodo en la calle Doctor Teijeiro.' },
];
---
<section class="proceso contenedor" aria-labelledby="proceso-titulo">
  <div class="proceso__foto">
    <figure class="proceso__fig" data-sube>
      <Image src={material} alt="Mesa de trabajo protegida con film: tintas, guantes y máquina" widths={[480, 760, 1000]} sizes="(max-width: 767px) 92vw, 34vw" class="mono" />
    </figure>
  </div>
  <div class="proceso__lista">
    <p class="etiqueta" data-sube>Cómo trabajamos</p>
    <h2 id="proceso-titulo" class="proceso__titulo gotica" data-sube><span class="linea"><span>De la idea</span></span><span class="linea"><span>a la piel</span></span></h2>
    <ol role="list">
      {pasos.map((p) => (
        <li class="paso" data-sube>
          <span class="paso__l gotica" aria-hidden="true">{p.l}.</span>
          <div>
            <h3 class="paso__t">{p.t}</h3>
            <p class="paso__d">{p.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proceso { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem 1.5rem; padding-block: clamp(6rem, 14vh, 10rem); align-items: start; }
  .proceso__foto { grid-column: 1 / 6; position: sticky; top: calc(var(--header-h) + 2rem); }
  .proceso__fig { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .proceso__fig :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .proceso__lista { grid-column: 7 / 13; display: flex; flex-direction: column; gap: 1.5rem; }
  .proceso__titulo { font-size: clamp(3.6rem, 7.5vw, 8rem); margin-bottom: 2rem; }
  .proceso ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgb(236 230 218 / .14); }
  .paso { position: relative; display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding: 1.75rem 0; border-bottom: 1px solid rgb(236 230 218 / .14); }
  .paso::after { content: ""; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: var(--color-laton); transform: scaleX(0); transform-origin: left; transition: transform .9s var(--ease-tinta); }
  .paso:hover::after { transform: scaleX(1); }
  .paso__l { font-size: 2.6rem; color: var(--color-laton); line-height: 1; }
  .paso__t { font-size: 1.35rem; font-weight: 500; letter-spacing: -0.01em; margin-bottom: .4rem; }
  .paso__d { color: var(--color-hueso-2); line-height: 1.55; max-width: 30rem; }
  @media (max-width: 767px) {
    .proceso__foto { grid-column: 1 / -1; position: relative; top: 0; }
    .proceso__lista { grid-column: 1 / -1; }
    .proceso__fig { aspect-ratio: 4 / 3; }
  }
</style>
